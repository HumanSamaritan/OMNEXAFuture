# Required for contact / booking notification email delivery through Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Destination mailbox for website enquiries and booking notifications
CONTACT_TO_EMAIL=dhiraj.kumar@omnexagoc.com

# Email used for reply-to on user confirmation emails
CONTACT_REPLY_EMAIL=dhiraj.kumar@omnexagoc.com

# Set to true only after CONTACT_FROM_EMAIL uses a Resend-verified domain.
CONTACT_SEND_CONFIRMATION=false

# Use a Resend verified domain email for production.
CONTACT_FROM_EMAIL=OMNeXa Website <noreply@omnexagoc.com>

# ---------------------------------------------------------------------------
# OMNeXa /connect booking flow
# ---------------------------------------------------------------------------

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) keys.
# Create keys for omnexagoc.com in the Google reCAPTCHA admin console.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace_with_site_key
RECAPTCHA_SECRET_KEY=replace_with_secret_key
# Optional strict production hostname check. Leave blank on preview deployments.
RECAPTCHA_EXPECTED_HOSTNAME=www.omnexagoc.com

# Used to sign short-lived booking sessions after reCAPTCHA verification.
# Generate a random secret of at least 32 characters.
BOOKING_SESSION_SECRET=replace_with_long_random_secret

# Booking rules. Times are interpreted in Asia/Singapore.
BOOKING_DURATION_MINUTES=30
BOOKING_SLOT_STEP_MINUTES=30
BOOKING_DAY_START=09:00
BOOKING_DAY_END=18:00
BOOKING_MIN_NOTICE_HOURS=4
BOOKING_HORIZON_DAYS=30
BOOKING_BUFFER_MINUTES=0

# Set true if the /connect flow should reject common personal email providers.
# Default recommendation is false so legitimate individuals can still book.
BOOKING_REQUIRE_WORK_EMAIL=false

# Google Calendar that acts as the source of truth for availability and invitations.
# For OAuth user credentials this can be "primary".
OMNEXA_BOOKING_CALENDAR_ID=primary

# RECOMMENDED Google Calendar authentication for a Workspace user.
# The refresh token must have Calendar scope and belong to the account that owns
# OMNEXA_BOOKING_CALENDAR_ID.
GOOGLE_CALENDAR_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALENDAR_REFRESH_TOKEN=replace_with_google_oauth_refresh_token

# ALTERNATIVE: service account authentication.
# If attendees must receive invitations, Workspace domain-wide delegation may be
# required. Set GOOGLE_WORKSPACE_SUBJECT to the Workspace user being impersonated.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=booking-service@project-id.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_WORKSPACE_SUBJECT=dhiraj.kumar@omnexagoc.com
