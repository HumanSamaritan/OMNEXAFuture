# Required for contact / booking notification email delivery through Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Destination mailbox for website enquiries and booking notifications
CONTACT_TO_EMAIL=dhiraj.kumar@omnexagoc.com

# Email used for reply-to on user confirmation emails
CONTACT_REPLY_EMAIL=dhiraj.kumar@omnexagoc.com

# Set to true only after CONTACT_FROM_EMAIL uses a Resend-verified domain.
CONTACT_SEND_CONFIRMATION=false

# Use a Resend verified domain email for production.
CONTACT_FROM_EMAIL=OMNeXa Website <noreply@omnexagoc.com>

# ---------------------------------------------------------------------------
# OMNeXa /connect booking flow
# ---------------------------------------------------------------------------

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace_with_checkbox_site_key
RECAPTCHA_PROJECT_ID=omnexa-website
RECAPTCHA_ENTERPRISE_API_KEY=replace_with_restricted_enterprise_api_key
RECAPTCHA_EXPECTED_HOSTNAME=www.omnexagoc.com
BOOKING_SESSION_SECRET=replace_with_long_random_secret
BOOKING_DURATION_MINUTES=30
BOOKING_SLOT_STEP_MINUTES=30
BOOKING_DAY_START=09:00
BOOKING_DAY_END=18:00
BOOKING_MIN_NOTICE_HOURS=4
BOOKING_HORIZON_DAYS=30
BOOKING_BUFFER_MINUTES=0
BOOKING_REQUIRE_WORK_EMAIL=false
OMNEXA_BOOKING_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALENDAR_REFRESH_TOKEN=replace_with_google_oauth_refresh_token

# ---------------------------------------------------------------------------
# Protected OMNeXa /admin HR workspace
# ---------------------------------------------------------------------------

ADMIN_DOMAIN=omnexagoc.com
# Comma-separated allow-list. Keep this limited to approved HR/admin users.
OMNEXA_ADMIN_EMAILS=dhiraj.kumar@omnexagoc.com
# Random server-only secret, at least 32 characters, used to sign admin sessions.
ADMIN_SESSION_SECRET=replace_with_long_random_admin_secret

# Isolated OMNeXa HR tables in Supabase. Do not expose HR_DB_SECRET to browsers.
HR_SUPABASE_URL=https://your-project.supabase.co
HR_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
HR_DB_SECRET=replace_with_hr_database_header_secret

# Optional Google Workspace Admin SDK integration for automatic @omnexagoc.com user creation.
# A Workspace super admin must configure Domain-Wide Delegation once for the service account,
# authorising scope: https://www.googleapis.com/auth/admin.directory.user
GOOGLE_WORKSPACE_ADMIN_CLIENT_EMAIL=workspace-admin-service@project-id.iam.gserviceaccount.com
GOOGLE_WORKSPACE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_WORKSPACE_ADMIN_SUBJECT=workspace-super-admin@omnexagoc.com

# Existing alternative calendar service-account variables, if used for booking:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=booking-service@project-id.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_WORKSPACE_SUBJECT=dhiraj.kumar@omnexagoc.com
